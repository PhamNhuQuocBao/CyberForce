# =============================================================================
# CYBERFORCE ENVIRONMENT CONFIGURATION
# =============================================================================

# -----------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION (PostgreSQL 16)
# -----------------------------------------------------------------------------
POSTGRES_USER=cyberforce
POSTGRES_PASSWORD=cyberforce_local_dev
POSTGRES_DB=cyberforce
POSTGRES_PORT=5432
DATABASE_URL="postgresql://cyberforce:cyberforce_local_dev@localhost:5432/cyberforce?schema=public"

# -----------------------------------------------------------------------------
# 2. CACHE & QUEUE (Redis 7.2)
# -----------------------------------------------------------------------------
REDIS_PORT=6379
REDIS_URL="redis://localhost:6379"

# -----------------------------------------------------------------------------
# 3. OBJECT STORAGE (MinIO S3 Compatible)
# -----------------------------------------------------------------------------
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ROOT_USER=cyberforce_minio
MINIO_ROOT_PASSWORD=cyberforce_minio_dev
MINIO_BUCKET_CERTS=certificates
MINIO_BUCKET_LAB_TEMPLATES=lab-templates

# -----------------------------------------------------------------------------
# 4. REMOTE DESKTOP DAEMON (Apache Guacamole)
# -----------------------------------------------------------------------------
GUACD_PORT=4822

# -----------------------------------------------------------------------------
# 5. CORE API SERVICE & AUTH SECURITY (JWT & Argon2id)
# -----------------------------------------------------------------------------
PORT=4000
NODE_ENV=development
API_BASE_URL="http://localhost:4000"
WEB_ORIGIN="http://localhost:3000"

JWT_ACCESS_SECRET="cyberforce_access_token_dev_secret_key_2026_super_secure_key"
JWT_REFRESH_SECRET="cyberforce_refresh_token_dev_secret_key_2026_super_secure_key"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# Master secret key for dynamic HMAC flag generation (TDD Section 9.1)
PLATFORM_MASTER_KEY="cyberforce_platform_master_hmac_secret_2026"

# -----------------------------------------------------------------------------
# 6. OAUTH2 PROVIDER INTEGRATION (Optional for mock test)
# -----------------------------------------------------------------------------
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
GITHUB_CALLBACK_URL="http://localhost:4000/api/v1/auth/oauth/github/callback"

GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_CALLBACK_URL="http://localhost:4000/api/v1/auth/oauth/google/callback"
