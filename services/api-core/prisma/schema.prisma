// Prisma Schema for CyberForce Core API Service
// Compliant with TDD_CYBERFORCE.md (Section 4.1 Data Dictionary)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// -----------------------------------------------------------------------------
// ENUMS
// -----------------------------------------------------------------------------

enum UserRole {
  student
  creator
  instructor
  org_admin
  superadmin

  @@map("user_role")
}

enum RoomType {
  walkthrough
  challenge
  koth
  exam

  @@map("room_type")
}

enum FlagType {
  static
  regex
  dynamic_hmac

  @@map("flag_type")
}

enum InstanceStatus {
  provisioning
  running
  terminating
  terminated

  @@map("instance_status")
}

enum RoleRequestStatus {
  pending
  approved
  rejected

  @@map("role_request_status")
}

// -----------------------------------------------------------------------------
// 1. USERS
// -----------------------------------------------------------------------------
model User {
  id           String    @id @default(uuid()) @db.Uuid
  email        String    @unique @db.VarChar(255)
  username     String    @unique @db.VarChar(50)
  passwordHash String?   @map("password_hash") @db.VarChar(255)
  avatarUrl    String?   @map("avatar_url") @db.Text
  role         UserRole  @default(student)
  expPoints    Int       @default(0) @map("exp_points")
  rankTier     String    @default("Novice") @map("rank_tier") @db.VarChar(30)
  streakDays   Int       @default(0) @map("streak_days")
  bio          String?   @db.Text
  specialty    String?   @default("General Cybersecurity") @db.VarChar(100)
  isPublic     Boolean   @default(true) @map("is_public")
  lastActiveAt DateTime  @default(now()) @map("last_active_at") @db.Timestamptz
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz

  // Relations
  labInstances     LabInstance[]
  submissions      Submission[]
  certificates     Certificate[]
  refreshTokens    RefreshToken[]
  oauthAccounts    OAuthAccount[]
  roleRequests     RoleRequest[]  @relation("UserRoleRequests")
  reviewedRequests RoleRequest[]  @relation("ReviewerRoleRequests")
  auditLogs        AuditLog[]     @relation("AuditLogActor")

  @@map("users")
}

// -----------------------------------------------------------------------------
// 1b. OAUTH ACCOUNTS (Multi-provider SSO & Account Linking)
// -----------------------------------------------------------------------------
model OAuthAccount {
  id                String   @id @default(uuid()) @db.Uuid
  userId            String   @map("user_id") @db.Uuid
  provider          String   @db.VarChar(30)
  providerAccountId String   @map("provider_account_id") @db.VarChar(255)
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("oauth_accounts")
}

// -----------------------------------------------------------------------------
// 1c. ROLE REQUESTS (Creator / Instructor Approval Workflow - CF-105 / US-01.04)
// -----------------------------------------------------------------------------
model RoleRequest {
  id              String            @id @default(uuid()) @db.Uuid
  userId          String            @map("user_id") @db.Uuid
  requestedRole   UserRole          @default(creator) @map("requested_role")
  status          RoleRequestStatus @default(pending)
  motivation      String            @db.Text
  specialty       String            @db.VarChar(100)
  portfolioUrl    String?           @map("portfolio_url") @db.VarChar(255)
  reviewerId      String?           @map("reviewer_id") @db.Uuid
  rejectionReason String?           @map("rejection_reason") @db.Text
  reviewedAt      DateTime?         @map("reviewed_at") @db.Timestamptz
  createdAt       DateTime          @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime          @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  user     User  @relation("UserRoleRequests", fields: [userId], references: [id], onDelete: Cascade)
  reviewer User? @relation("ReviewerRoleRequests", fields: [reviewerId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([status])
  @@map("role_requests")
}

// -----------------------------------------------------------------------------
// 1d. AUDIT LOGS (Security & RBAC Compliance - CF-105 / US-01.04)
// -----------------------------------------------------------------------------
model AuditLog {
  id        String   @id @default(uuid()) @db.Uuid
  action    String   @db.VarChar(100)
  actorId   String?  @map("actor_id") @db.Uuid
  targetId  String?  @map("target_id") @db.Uuid
  details   Json?
  ipAddress String?  @map("ip_address") @db.VarChar(45)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  actor User? @relation("AuditLogActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([action])
  @@index([actorId])
  @@index([targetId])
  @@index([createdAt])
  @@map("audit_logs")
}

// -----------------------------------------------------------------------------
// 2. REFRESH TOKENS (For JWT Revocation & Multi-device Auth)
// -----------------------------------------------------------------------------
model RefreshToken {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  tokenHash String   @unique @map("token_hash") @db.VarChar(255)
  revoked   Boolean  @default(false)
  expiresAt DateTime @map("expires_at") @db.Timestamptz
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

// -----------------------------------------------------------------------------
// 3. LEARNING PATHS
// -----------------------------------------------------------------------------
model LearningPath {
  id              String   @id @default(uuid()) @db.Uuid
  title           String   @db.VarChar(255)
  slug            String   @unique @db.VarChar(255)
  description     String?  @db.Text
  difficultyLevel String   @default("Beginner") @map("difficulty_level") @db.VarChar(20)
  iconUrl         String?  @map("icon_url") @db.Text
  orderIndex      Int      @default(0) @map("order_index")
  isPublished     Boolean  @default(false) @map("is_published")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz

  // Relations
  rooms        Room[]
  certificates Certificate[]

  @@map("learning_paths")
}

// -----------------------------------------------------------------------------
// 4. ROOMS
// -----------------------------------------------------------------------------
model Room {
  id                 String    @id @default(uuid()) @db.Uuid
  pathId             String?   @map("path_id") @db.Uuid
  title              String    @db.VarChar(255)
  slug               String    @unique @db.VarChar(255)
  description        String?   @db.Text
  difficulty         String    @default("Easy") @db.VarChar(20)
  roomType           RoomType  @default(walkthrough) @map("room_type")
  targetTemplateSpec Json      @map("target_template_spec")
  isFree             Boolean   @default(true) @map("is_free")
  publishedAt        DateTime? @map("published_at") @db.Timestamptz
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz

  // Relations
  learningPath LearningPath? @relation(fields: [pathId], references: [id], onDelete: SetNull)
  tasks        Task[]
  labInstances LabInstance[]

  @@index([pathId])
  @@map("rooms")
}

// -----------------------------------------------------------------------------
// 5. TASKS & QUESTIONS
// -----------------------------------------------------------------------------
model Task {
  id         String   @id @default(uuid()) @db.Uuid
  roomId     String   @map("room_id") @db.Uuid
  taskOrder  Int      @map("task_order")
  title      String   @db.VarChar(255)
  contentMdx String   @map("content_mdx") @db.Text
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz

  // Relations
  room      Room       @relation(fields: [roomId], references: [id], onDelete: Cascade)
  questions Question[]

  @@index([roomId])
  @@map("tasks")
}

model Question {
  id           String   @id @default(uuid()) @db.Uuid
  taskId       String   @map("task_id") @db.Uuid
  questionText String   @map("question_text") @db.Text
  answerHash   String?  @map("answer_hash") @db.VarChar(255)
  flagPattern  String?  @map("flag_pattern") @db.VarChar(255)
  flagType     FlagType @default(static) @map("flag_type")
  hintTiers    Json?    @map("hint_tiers")
  pointsReward Int      @default(50) @map("points_reward")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz

  // Relations
  task        Task         @relation(fields: [taskId], references: [id], onDelete: Cascade)
  submissions Submission[]

  @@index([taskId])
  @@map("questions")
}

// -----------------------------------------------------------------------------
// 6. LAB INSTANCES (Sandbox sessions)
// -----------------------------------------------------------------------------
model LabInstance {
  id           String         @id @default(uuid()) @db.Uuid
  userId       String         @map("user_id") @db.Uuid
  roomId       String         @map("room_id") @db.Uuid
  ipAddress    String         @map("ip_address") @db.VarChar(45)
  instanceType String         @default("docker") @map("instance_type") @db.VarChar(20)
  containerId  String?        @map("container_id") @db.VarChar(128)
  status       InstanceStatus @default(provisioning)
  dynamicSalt  String         @map("dynamic_salt") @db.VarChar(64)
  expiresAt    DateTime       @map("expires_at") @db.Timestamptz
  createdAt    DateTime       @default(now()) @map("created_at") @db.Timestamptz

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  room Room @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([roomId])
  @@index([containerId])
  @@map("lab_instances")
}

// -----------------------------------------------------------------------------
// 7. SUBMISSIONS
// -----------------------------------------------------------------------------
model Submission {
  id             String   @id @default(uuid()) @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  questionId     String   @map("question_id") @db.Uuid
  submittedValue String   @map("submitted_value") @db.Text
  isCorrect      Boolean  @map("is_correct")
  pointsEarned   Int      @default(0) @map("points_earned")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz

  // Relations
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([userId, questionId])
  @@index([questionId])
  @@map("submissions")
}

// -----------------------------------------------------------------------------
// 8. CERTIFICATES
// -----------------------------------------------------------------------------
model Certificate {
  id               String   @id @default(uuid()) @db.Uuid
  certificateCode  String   @unique @map("certificate_code") @db.VarChar(50)
  userId           String   @map("user_id") @db.Uuid
  pathId           String   @map("path_id") @db.Uuid
  scorePercentage  Decimal  @map("score_percentage") @db.Decimal(5, 2)
  verificationHash String   @map("verification_hash") @db.VarChar(255)
  pdfS3Key         String   @map("pdf_s3_key") @db.Text
  issuedAt         DateTime @default(now()) @map("issued_at") @db.Timestamptz
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz

  // Relations
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  learningPath LearningPath @relation(fields: [pathId], references: [id])

  @@index([pathId])
  @@index([userId])
  @@map("certificates")
}
